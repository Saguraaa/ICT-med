# 本地演示改为 demo；云端真实模型调用使用 openai。
MODEL_BACKEND=openai
# 填写你已经开通的模型名称，不要照搬论文的旧名称。
MODEL_NAME=
MODEL_URL=https://api.modelarts-maas.com/openai/v1
MODEL_API_KEY=
# auto: DeepSeek 官方地址开启 JSON Output；其他兼容服务不强加此参数。
# 其他支持 JSON Output 的模型可设 true；不支持时设 false。
MODEL_JSON_MODE=auto
AGENT_RUN_PORT=8080

# 不填则使用 data/knowledge.jsonl 的本地关键词检索。
# 自建 MedRAG/平台检索适配服务的完整 HTTP URL，合同见 docs/RETRIEVAL.md。
RETRIEVAL_URL=
RETRIEVAL_API_KEY=
KNOWLEDGE_PATH=data/knowledge.jsonl
RULES_PATH=data/red_flags.json
RETRIEVAL_TOP_K=4

MAX_MODEL_CALLS=16
MAX_DISCUSSION_ROUNDS=2
MAX_SPECIALISTS=3
ROUTING_STRATEGY=adaptive
REQUEST_DEADLINE_SECONDS=90
MODEL_TIMEOUT_SECONDS=25

# 原型默认不自动发布真实分诊建议。开启还要求真实规则和证据均经审核。
# 开关本身不代表获得临床验证；详见 README。
ENABLE_TRIAGE_OUTPUT=false

# 仅 local_app.py 使用。云端由 AgentArts 入站鉴权保护。
LOCAL_API_TOKEN=
